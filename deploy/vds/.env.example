# Скопируйте в .env и заполните. .env в git не попадает.
#
# Пароли и секреты генерируйте без спецсимволов, чтобы не ломать URL:
#   openssl rand -hex 24
#
# DNS: A-записи chat, rtc и s3 должны указывать на публичный IP VDS.

# Домены. Пример: chat.example.com, rtc.example.com, s3.example.com.
DOMAIN=chat.example.com
RTC_DOMAIN=rtc.example.com

# Имя сертификата Let's Encrypt: один сертификат на все три имени.
CERT_NAME=voxnica
LETSENCRYPT_EMAIL=admin@example.com

POSTGRES_DB=voxnica
POSTGRES_USER=dc
POSTGRES_PASSWORD=change-me-hex

# 32+ символа, иначе сервер предупредит.
JWT_SECRET=change-me-hex

# Ключи LiveKit. Секрет — 32+ символа.
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me-hex-32-bytes

# Ключи S3/SeaweedFS.
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me-hex-32-bytes
STORAGE_BUCKET=voxnica
